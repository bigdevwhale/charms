    <!-- creatures -->
    <string name="cr_owl">Midnight Owl</string>
    <string name="cr_owl_about">Keeps watch over books and lessons. Reads upside down and never tells anyone the ending.</string>
    <string name="cr_cat">Bayun the Cat</string>
    <string name="cr_cat_about">The cat from the old tales whose songs put anyone to sleep. Fond of a well-made bed.</string>
    <string name="cr_fox">Tidy Fox</string>
    <string name="cr_fox_about">Washes her paws seven times a day and her teeth shine in the dark. Can\'t stand a crumb.</string>
    <string name="cr_hare">Moon Hare</string>
    <string name="cr_hare_about">Lives on the moon and comes down for a run in the fresh air. Leaves silver tracks.</string>
    <string name="cr_raven">Keeper Raven</string>
    <string name="cr_raven_about">Remembers where everything lies. If something is missing from the bag, he knows already.</string>
    <string name="cr_hedgehog">Housekeeping Hedgehog</string>
    <string name="cr_hedgehog_about">Carries apples, mushrooms and lost socks to their places. Every place, every thing.</string>
    <string name="cr_snail">Water Snail</string>
    <string name="cr_snail_about">Loves warm water and steam. In her shell there\'s a bath with a sea view.</string>
    <string name="cr_firefly">Lamplighter Firefly</string>
    <string name="cr_firefly_about">Lights the way to bed and puts the lamp out when the sorcerer falls asleep.</string>

